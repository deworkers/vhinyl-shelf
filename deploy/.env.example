DISCOGS_TOKEN=replace_with_your_discogs_token
DISCOGS_USER_AGENT=VinylShelf/1.0 +https://vinyl.example.com
APP_BIND=127.0.0.1
APP_PORT=8080
ADMIN_USERNAME=admin
# Set a unique password (12–128 characters) before the first deployment.
# If empty, a random password is saved to /app/data/admin-credentials.txt.
ADMIN_PASSWORD=
APP_ORIGIN=https://vinyl.example.com
# Number of trusted proxies: external HTTPS proxy + frontend nginx.
TRUST_PROXY=2
